#!/bin/bash
set -e

# 1. Cargar la librería oficial de debconf
. /usr/share/debconf/confmodule

# 2. Registrar la pregunta dinámicamente sin bloquear la DB
# Registramos una pregunta genérica y le asignamos nuestros textos
db_register debconf/boolean remotecontroltray/copy-desktop || true
db_subst remotecontroltray/copy-desktop description "¿Deseas crear un acceso directo en el escritorio?" || true
db_set remotecontroltray/copy-desktop true || true

# 3. Mostrar la pregunta
db_input high remotecontroltray/copy-desktop || true
db_go || true

# 4. Obtener respuesta y ejecutar lógica
db_get remotecontroltray/copy-desktop
if [ "$RET" = "true" ]; then
    REAL_USER=${SUDO_USER:-$USER}

    if [ "$REAL_USER" != "root" ]; then
        USER_HOME=$(getent passwd "$REAL_USER" | cut -d: -f6)

        # Detectar ruta del escritorio
        DESKTOP_DIR=$(sudo -u "$REAL_USER" xdg-user-dir DESKTOP 2>/dev/null || echo "$USER_HOME/Desktop")

        SRC="/opt/remotecontroltray/lib/remotecontroltray-RemoteControlTray.desktop"
        DEST="$DESKTOP_DIR/remotecontroltray-RemoteControlTray.desktop"

        if [ -f "$SRC" ]; then
            mkdir -p "$DESKTOP_DIR"
            cp "$SRC" "$DEST"
            chown "$REAL_USER":"$REAL_USER" "$DEST"
            chmod +x "$DEST"
        fi
    fi
fi

# Finalizar debconf correctamente
db_stop
